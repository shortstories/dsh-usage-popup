{
  "name": "dsh-usage-popup",
  "version": "0.3.0",
  "private": true,
  "description": "DSH Web plugin: Codex, Gemini Web, DeepSeek, OpenRouter and OpenGateway limits plus local token usage on the Settings → Models page",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shortstories/dsh-usage-popup.git"
  },
  "homepage": "https://github.com/shortstories/dsh-usage-popup#readme",
  "bugs": {
    "url": "https://github.com/shortstories/dsh-usage-popup/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "usage",
    "quota",
    "codex",
    "gemini",
    "deepseek",
    "openrouter",
    "opengateway"
  ]
}
